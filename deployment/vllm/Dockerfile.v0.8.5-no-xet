FROM vllm/vllm-openai:v0.8.5@sha256:6cf9808ca8810fc6c3fd0451c2e7784fb224590d81f7db338e7eaf3c02a33d33

# huggingface_hub 0.30.2 predates HF_HUB_DISABLE_XET support. Its bundled
# hf-xet 1.0.5 selects Xet unconditionally and receives unusable signed URLs
# behind the deployment proxy. Removing only that optional transport preserves
# the tested vLLM runtime and makes huggingface_hub use resumable HTTPS instead.
RUN python3 -m pip uninstall --yes hf-xet \
    && python3 -c "import importlib.util; assert importlib.util.find_spec('hf_xet') is None"
