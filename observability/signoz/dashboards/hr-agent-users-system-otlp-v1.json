  "widgets": [
    {
      "description": "只展示邮箱 @ 前的账号名；不会导出完整邮箱、域名、姓名或内部用户 ID。",
      "id": "81000000-0000-4000-8000-000000000001",
      "panelTypes": "row",
      "title": "多用户使用"
    },
    {
      "description": "当前看板时间范围内至少使用过一次系统的去重账号数。",
      "id": "82000000-0000-4000-8000-000000000001",
      "isStacked": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "value",
      "query": {
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "clickhouse_sql": [
          {
            "disabled": false,
            "legend": "使用用户数",
            "name": "A",
            "query": "WITH user_series AS (\n  SELECT DISTINCT fingerprint, JSONExtractString(labels, 'hr_agent.user.id') AS account_name\n  FROM signoz_metrics.distributed_time_series_v4_1day\n  WHERE metric_name = 'hr_agent.user.request'\n    AND temporality = 'Delta'\n    AND unix_milli >= intDiv({{.start_timestamp_ms}}, 86400000) * 86400000\n    AND unix_milli < {{.end_timestamp_ms}}\n    AND JSONExtractString(labels, 'deployment.environment') = $deployment.environment\n    AND JSONExtractString(labels, 'service.name') = $service.name\n    AND account_name != ''\n    AND account_name != 'system'\n), active_series AS (\n  SELECT fingerprint\n  FROM signoz_metrics.distributed_samples_v4\n  WHERE metric_name = 'hr_agent.user.request'\n    AND temporality = 'Delta'\n    AND unix_milli >= {{.start_timestamp_ms}}\n    AND unix_milli < {{.end_timestamp_ms}}\n    AND value > 0\n  GROUP BY fingerprint\n)\nSELECT toFloat64(countDistinct(account_name)) AS value\nFROM user_series\nINNER JOIN active_series USING (fingerprint)"
          }
        ],
        "id": "82000000-0000-5000-8000-000000000001",
        "promql": [
          {
            "disabled": false,
            "legend": "",
            "name": "A",
            "query": ""
          }
        ],
        "queryType": "clickhouse_sql"
      },
      "thresholds": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "当前范围使用用户数",
      "yAxisUnit": "short"
    },
    {
      "description": "列出当前看板时间范围内实际使用过系统的账号及其最近使用时间。",
      "id": "82000000-0000-4000-8000-000000000002",
      "isStacked": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "panelTypes": "table",
      "query": {
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "clickhouse_sql": [
          {
            "disabled": false,
            "legend": "使用用户",
            "name": "A",
            "query": "WITH user_series AS (\n  SELECT DISTINCT fingerprint, JSONExtractString(labels, 'hr_agent.user.id') AS account_name\n  FROM signoz_metrics.distributed_time_series_v4_1day\n  WHERE metric_name = 'hr_agent.user.request'\n    AND temporality = 'Delta'\n    AND unix_milli >= intDiv({{.start_timestamp_ms}}, 86400000) * 86400000\n    AND unix_milli < {{.end_timestamp_ms}}\n    AND JSONExtractString(labels, 'deployment.environment') = $deployment.environment\n    AND JSONExtractString(labels, 'service.name') = $service.name\n    AND account_name != ''\n    AND account_name != 'system'\n), active_series AS (\n  SELECT fingerprint, max(unix_milli) AS last_seen_ms\n  FROM signoz_metrics.distributed_samples_v4\n  WHERE metric_name = 'hr_agent.user.request'\n    AND temporality = 'Delta'\n    AND unix_milli >= {{.start_timestamp_ms}}\n    AND unix_milli < {{.end_timestamp_ms}}\n    AND value > 0\n  GROUP BY fingerprint\n)\nSELECT\n  account_name AS `用户`,\n  toDateTime(intDiv(max(last_seen_ms), 1000), 'Asia/Shanghai') AS `最近使用时间`\nFROM user_series\nINNER JOIN active_series USING (fingerprint)\nGROUP BY account_name\nORDER BY `最近使用时间` DESC"
          }
        ],
        "id": "82000000-0000-5000-8000-000000000002",
        "promql": [
          {
            "disabled": false,
            "legend": "",
            "name": "A",
            "query": ""
          }
        ],
        "queryType": "clickhouse_sql"
      },
      "thresholds": [],
      "timePreferance": "GLOBAL_TIME",
      "title": "当前范围使用用户",
      "yAxisUnit": "none",
      "columnUnits": {},
      "mergeAllActiveQueries": false
    },
