# 容器运行模式：production 使用 Nginx/镜像代码；development 启用前后端源码热更新。
# 修改此项后需重新执行 Compose up；源码修改随后会自动生效。
APP_RUNTIME_MODE=production

# ==============================
# 模型聊天 API
# LLM_PROVIDER: 聊天接口兼容模式；当前使用 Bosch OpenAI-compatible chat/completions。
# CHAT_API_ENDPOINT: 聊天模型接口地址。API_KEY 由聊天、Embedding、Reranker 共用。
# MODEL_API_AUTH_MODE / MODEL_API_KEY_HEADER_NAME: 认证方式和请求头。
LLM_PROVIDER=bosch_openai_compatible
CHAT_API_ENDPOINT=https://aigc.bosch.com.cn/llmservice/api/v1/chat/completions
# Comma-separated independent deployments used for load-aware routing/failover.
CHAT_API_ENDPOINTS=
MODEL_API_AUTH_MODE=bearer
MODEL_API_KEY_HEADER_NAME=Authorization
API_KEY=

# 前端工作流的页面级介绍；true 表示在每个页面首次进入时显示。
WORKFLOW_PAGE_GUIDE_ENABLED=true
# true 表示每次重新进入页面都显示；点击后仅关闭当前这次访问。
WORKFLOW_PAGE_GUIDE_ALWAYS_SHOW=true

# local 启动本地 Embedding/Reranker；platform 调用上方 API_KEY 鉴权的平台接口。
MODEL_PROVIDER_MODE=local

# ==============================
# 本地模型 GPU 放置（宿主机物理 GPU 编号）
# 修改卡号后需 force-recreate 对应模型容器，普通 restart 不会更新 GPU 映射。
MINERU_GPU_DEVICE=0
QWEN_EMBEDDING_GPU_DEVICE=0
QWEN_RERANKER_GPU_DEVICE=1
# 影子 Reranker 必须保持在独立的 GPU 1；GPU 1 故障时先修复设备，不要改绑 GPU 0。
QWEN_RERANKER_SHADOW_GPU_DEVICE=1
QWEN3_ASR_PRIMARY_GPU_DEVICE=0
QWEN3_ASR_SECONDARY_GPU_DEVICE=0
FISH_TTS_GPU_DEVICE=1

HR_AGENT_BACKEND_IMAGE=06-emotion-main-backend:local
BACKEND_REPLICAS=2
BACKEND_AUTOSCALER_MIN_REPLICAS=2
BACKEND_AUTOSCALER_MAX_REPLICAS=8
BACKEND_AUTOSCALER_TARGET_USERS_PER_REPLICA=8
BACKEND_AUTOSCALER_SPARE_REPLICAS=1
BACKEND_AUTOSCALER_ACTIVE_WINDOW_SECONDS=300
BACKEND_AUTOSCALER_POLL_SECONDS=10
BACKEND_AUTOSCALER_SCALE_DOWN_STABILIZATION_SECONDS=900
BACKEND_AUTOSCALER_SCALE_DOWN_COOLDOWN_SECONDS=300
BACKEND_AUTOSCALER_SCALE_DOWN_MIN_IDLE_SECONDS=30
BACKEND_AUTOSCALER_START_HEALTH_TIMEOUT_SECONDS=120
BACKEND_AUTOSCALER_START_HEALTH_POLL_SECONDS=1
BACKEND_AUTOSCALER_SCALE_DOWN_PROBE_INTERVAL_SECONDS=1
BACKEND_AUTOSCALER_STOP_TIMEOUT_SECONDS=300
BACKEND_AUTOSCALER_RECONCILE_LEASE_SECONDS=1500
BACKEND_AUTOSCALER_WATCHDOG_STALE_SECONDS=30

# ==============================
# 任务模型路由
# DEFAULT_CHAT_MODEL: 兜底模型。其余 *_MODEL 按任务覆盖。
# CHAT_MODEL 如显式设置，会覆盖所有任务模型；默认留空。
DEFAULT_CHAT_MODEL=glm-5.2
PROFILE_MODEL=glm-5.2
INTENT_MODEL=glm-5.2
EMPLOYEE_MODEL=qwen3.6-flash
CONVERSATION_SUMMARY_MODEL=qwen3.6-flash
MOTIVATION_SCORING_MODEL=qwen3.6-flash
EMOTION_TRANSITION_MODEL=qwen3.6-flash
REHEARSAL_DIMENSION_MODEL=qwen3.6-flash
GUIDANCE_MODEL=glm-5.2
COACH_EVALUATOR_MODEL=glm-5.2
MODEL_RETRY_RACE_MODEL=deepseek-v4-pro
COACH_REDLINE_MODEL=glm-5.2

# 所有既定模型重试耗尽后，是否允许使用同一 owner + employee + intent 下的
# 历史成功产物。默认关闭；启用后仍需通过人格、诉求、上下文和证据校验。
MODEL_HISTORY_FALLBACK_ENABLED=false
MODEL_HISTORY_FALLBACK_MAX_SESSIONS=50
MODEL_HISTORY_FALLBACK_MAX_AGE_DAYS=730
MODEL_HISTORY_FALLBACK_MIN_SESSION_SIMILARITY=0.78
MODEL_HISTORY_FALLBACK_MIN_REPLY_SIMILARITY=0.72
MODEL_HISTORY_FALLBACK_MIN_CONVERSATION_SIMILARITY=0.88

# 意图页第二阶段：员工当前表现反推
INTENT_PERFORMANCE_MODEL=glm-5.2
LLM_INTENT_PERFORMANCE_TEMPERATURE=0.4
LLM_INTENT_PERFORMANCE_MAX_TOKENS=8192
INTENT_PERFORMANCE_LLM_TIMEOUT_SECONDS=120
LLM_INTENT_PERFORMANCE_ENABLE_THINKING=false
PERSONALITY_FACET_MODEL=qwen3.6-flash
LLM_PERSONALITY_FACET_TEMPERATURE=0.2
LLM_PERSONALITY_FACET_MAX_TOKENS=1200
PERSONALITY_FACET_LLM_TIMEOUT_SECONDS=45
LLM_PERSONALITY_FACET_ENABLE_THINKING=false

# 对话右侧四维语义评估
LLM_REHEARSAL_DIMENSION_TEMPERATURE=0
LLM_REHEARSAL_DIMENSION_MAX_TOKENS=256
REHEARSAL_DIMENSION_LLM_TIMEOUT_SECONDS=20
LLM_REHEARSAL_DIMENSION_ENABLE_THINKING=false

# ==============================
# LLM 费用核算
# 单价单位固定为 CNY / 1,000,000 tokens。优先匹配 provider/model，再回退到 model。
# tiers 中的价格在输入 Token 不超过 max_input_tokens 时生效；超过后使用模型默认价格。
LLM_PRICING_VERSION=model-farm-cny-2026-07-21
LLM_MODEL_PRICING='{"deepseek-v4-pro":{"input_per_million":12.0,"cached_input_per_million":1.0,"output_per_million":24.0},"qwen3.7-max":{"input_per_million":12.0,"output_per_million":36.0},"qwen3.7-plus":{"input_per_million":6.0,"output_per_million":24.0,"tiers":[{"max_input_tokens":256000,"input_per_million":2.0,"output_per_million":8.0}]},"qwen3.6-flash":{"input_per_million":4.8,"cached_input_per_million":0.48,"output_per_million":28.8,"tiers":[{"max_input_tokens":256000,"input_per_million":1.2,"cached_input_per_million":0.12,"output_per_million":7.2}]},"doubao-seed-evolving":{"input_per_million":6.0,"cached_input_per_million":1.2,"output_per_million":30.0},"doubao-seed-2.1-pro":{"input_per_million":6.0,"cached_input_per_million":1.2,"output_per_million":30.0},"doubao-seed-2.1-turbo":{"input_per_million":3.0,"cached_input_per_million":0.6,"output_per_million":15.0},"glm-5.2":{"input_per_million":8.0,"cached_input_per_million":2.0,"output_per_million":28.0}}'

# ==============================
# Embedding API
# 本地 Qwen3-Embedding-4B 服务，用于知识库入库和 query embedding。
EMBEDDING_PROVIDER=bosch
EMBEDDING_API_ENDPOINT=http://qwen_embedding:8000/v1/embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_LOCAL_DIMENSIONS=2560
# platform 模式使用独立维度。
EMBEDDING_PLATFORM_DIMENSIONS=2048
EMBEDDING_API_BATCH_SIZE=46

# ==============================
# Rerank API
# 本地 Qwen3-Reranker-4B 服务，用于 RAG 检索后的相关性重排。
RERANK_PROVIDER=bosch
RERANK_LOCAL_API_ENDPOINT=http://qwen_reranker:8000/v1/rerank
RERANK_LOCAL_MODEL=Qwen/Qwen3-Reranker-4B
# 生产使用 vLLM pooling runner 的原生 rerank 协议。
RERANK_LOCAL_PROTOCOL=rerank
# platform 模式在部署环境中填写对应的原生 rerank 端点和模型名。
RERANK_API_ENDPOINT=
RERANK_MODEL=
# 仅供宿主机 A/B 脚本使用；影子服务默认不启动，且只监听 127.0.0.1。
RERANK_SHADOW_PROTOCOL=rerank
RERANK_SHADOW_API_ENDPOINT=http://127.0.0.1:7123/v1/rerank
QWEN_RERANKER_SHADOW_PORT=7123
QWEN_RERANK_SHADOW_GPU_MEMORY_UTILIZATION=0.46
QWEN_RERANK_SHADOW_MAX_NUM_BATCHED_TOKENS=16384
QWEN_RERANK_SHADOW_MAX_NUM_SEQS=64
# vLLM 可使用的单卡显存比例；0.35 可满足 8192 上下文并为同卡其他服务保留空间。
QWEN_RERANK_GPU_MEMORY_UTILIZATION=0.35
# Reranker 以 prefill 为主；24K token / 96 sequence 作为首个稳妥的吞吐档位。
QWEN_RERANK_MAX_NUM_BATCHED_TOKENS=24576
QWEN_RERANK_MAX_NUM_SEQS=96

# ==============================
# 模型启动预热
# 启动后在后台并发预热去重后的聊天模型、Embedding、Reranker、实时/HTTP ASR。
# 默认不阻塞 FastAPI 就绪；单个模型失败不会阻断其他模型或应用启动。
MODEL_WARMUP_ENABLED=true
MODEL_WARMUP_BLOCK_STARTUP=false
MODEL_WARMUP_TIMEOUT_SECONDS=900
MODEL_WARMUP_MAX_CONCURRENCY=4

# ==============================
# 本地 Qwen 容器生命周期
# 首次请求自动启动；Embedding/Reranker 最后一次请求完成 3600 秒后停止。
# Docker 控制严格限制为 qwen_embedding 和 qwen_reranker 两个 service。
LOCAL_MODEL_AUTO_RECYCLE_ENABLED=true
LOCAL_MODEL_AUTO_START_ENABLED=true
LOCAL_MODEL_PINNED_SERVICES=
LOCAL_MODEL_CONTROLLER_URL=http://local_model_controller:7120
LOCAL_MODEL_IDLE_TTL_SECONDS=3600
LOCAL_MODEL_RECYCLE_CHECK_INTERVAL_SECONDS=30
LOCAL_MODEL_START_TIMEOUT_SECONDS=900
LOCAL_MODEL_HEALTH_POLL_INTERVAL_SECONDS=2
LOCAL_MODEL_DOCKER_SOCKET_PATH=/var/run/docker.sock
LOCAL_MODEL_DOCKER_PROJECT_NAME=06
LOCAL_MODEL_STOP_TIMEOUT_SECONDS=30

# ==============================
# MinerU 文档解析
# MINERU_API_URL 是 backend 容器内访问 mineru 服务的地址。
# MINERU_FAIL_ON_ERROR=true 表示解析失败时直接暴露错误，不静默降级。
# medium 是日常文档快速档；只有确实需要图片语义分析或最高精度时才改为 high。
MINERU_ENABLED=true
MINERU_API_URL=http://mineru:7112
MINERU_BACKEND=hybrid-engine
MINERU_EFFORT=medium
MINERU_PARSE_METHOD=auto
MINERU_TIMEOUT_SECONDS=1800
MINERU_FAIL_ON_ERROR=true

# ==============================
# 文档图片多模态解读
# 默认启用；当前 API Key 需要已开通 qwen3.7-plus。
# 图片仅以 Base64 Data URL 发送到当前 CHAT_API_ENDPOINT，不会上传公网。
DOCUMENT_VISION_ENABLED=true
DOCUMENT_VISION_MODEL=qwen3.7-plus
DOCUMENT_VISION_PROMPT_VERSION=v1
DOCUMENT_VISION_TEMPERATURE=0.1
DOCUMENT_VISION_MAX_TOKENS=1600
DOCUMENT_VISION_TIMEOUT_SECONDS=120
DOCUMENT_VISION_MAX_CONCURRENCY=2
DOCUMENT_VISION_BATCH_SIZE=4
DOCUMENT_VISION_MAX_IMAGE_BYTES=10000000
DOCUMENT_VISION_CONTEXT_CHARS=3000
DOCUMENT_VISION_PREFLIGHT_ENABLED=true
DOCUMENT_VISION_FAIL_ON_ERROR=false

# ==============================
# 向量库和知识库索引
# VECTOR_COLLECTION_PREFIX 会与 scope 组合成 collection 名，例如 hr_agent_kb_redline。
VECTORSTORE_PROVIDER=postgres_pgvector
DATABASE_URL=postgresql://hr_agent:hr_agent@pgbouncer:6432/hr_agent
DATABASE_ADMIN_URL=postgresql://hr_agent:hr_agent@postgres:7114/hr_agent
POSTGRES_AUTO_INITIALIZE_SCHEMA=false
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=122
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_CREATE_HNSW_INDEX=true
POSTGRES_ANN_MIN_ROWS=10000
POSTGRES_ANN_FORCE_SCOPES=employee,organization_unit
POSTGRES_HNSW_ITERATIVE_SCAN=relaxed_order
POSTGRES_HNSW_EF_SEARCH=100
POSTGRES_HNSW_MAX_SCAN_TUPLES=20000
POSTGRES_BM25_LIMIT=200
POSTGRES_BM25_TOKENIZER_NAME=kb_jieba_v1
RAG_DB_SEARCH_MAX_CONCURRENCY=0
RAG_THREAD_POOL_MAX_WORKERS=98
RAG_GLOBAL_DB_SEARCH_MAX_CONCURRENCY=0
WORKFLOW_DB_THREAD_POOL_MAX_WORKERS=16
WORKFLOW_GLOBAL_DB_MAX_CONCURRENCY=64
RAG_RERANK_MAX_CONCURRENCY=98
RAG_GLOBAL_RERANK_MAX_CONCURRENCY=98
MODEL_TOTAL_MAX_CONCURRENCY=0
RAG_HYBRID_SEARCH_ENABLED=true
RAG_AGENTIC_SEARCH_MODE=off
RAG_AGENTIC_SEARCH_SHADOW_SAMPLE_RATE=0
RAG_AGENTIC_SEARCH_ACTIVE_SAMPLE_RATE=1.0
RAG_AGENTIC_SEARCH_TIMEOUT_SECONDS=45
VECTOR_COLLECTION_PREFIX=hr_agent_kb
KB_SYNC_ON_STARTUP=true
KB_STARTUP_SYNC_WAIT_TIMEOUT_SECONDS=3600
KB_INGEST_BATCH_SIZE=11
KB_CHUNK_SIZE=2048
KB_CHUNK_OVERLAP=160
KB_PARENT_CONTEXT_MAX_CHARS=12000
KB_PARENT_CONTEXT_BOUNDARY_SCAN_CHARS=800
KB_INDEX_VERSION=v3

# ==============================
# LLM 生成参数
# EMPLOYEE_TEMPERATURE 更高，用于员工模拟自然度。
# *_MAX_TOKENS 按任务控制输出长度。
# LLM_ENABLE_THINKING 是未知任务的兜底值；调用处显式参数具有最高优先级。
# LLM_THINKING_BUDGET 仅在当前任务开启 thinking 时发送。
LLM_TEMPERATURE=0.1
LLM_EMPLOYEE_TEMPERATURE=0.9
# true 使用独立的逐句层面与输入依据标注 Prompt；false 使用生产员工 Prompt。
EMPLOYEE_REPLY_TEST_PROMPT_ENABLED=false
# 员工回复历史默认采用 SELF/PARTNER；legacy_labels 仅用于快速回退角色标签。
EMPLOYEE_DIALOGUE_HISTORY_MODE=ecp_labels
# Pattern 总开关：同时控制模型计算、心理状态更新和员工 Reply 指导；关闭时回退原有 VAD 流程。
PSYCHOLOGICAL_PATTERN_DYNAMICS_ENABLED=true
# 心理模式专用上下文限制；不改变 CONVERSATION_RAW_TURN_WINDOW。
PSYCHOLOGICAL_PATTERN_HISTORY_TURNS=8
PSYCHOLOGICAL_PATTERN_SUPPLEMENTAL_MAX_CHARS=2000
PROMPT_AUTO_RELOAD_ENABLED=true
LLM_CONVERSATION_SUMMARY_TEMPERATURE=0
LLM_MOTIVATION_SCORING_TEMPERATURE=0
LLM_EMOTION_TRANSITION_TEMPERATURE=0
LLM_GUIDANCE_TEMPERATURE=0.1
LLM_COACH_EVALUATOR_TEMPERATURE=0
LLM_COACH_REDLINE_TEMPERATURE=0
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=8192
LLM_PROFILE_ENABLE_THINKING=false
LLM_INTENT_ENABLE_THINKING=false
LLM_EMPLOYEE_REPLY_ENABLE_THINKING=false
LLM_CONVERSATION_SUMMARY_ENABLE_THINKING=true
LLM_MOTIVATION_SCORING_ENABLE_THINKING=false
LLM_EMOTION_TRANSITION_ENABLE_THINKING=false
LLM_GUIDANCE_ENABLE_THINKING=true
LLM_COACH_EVALUATOR_ENABLE_THINKING=true
LLM_COACH_REDLINE_ENABLE_THINKING=true
LLM_DOCUMENT_VISION_ENABLE_THINKING=true
LLM_MAX_TOKENS=8192
LLM_PROFILE_MAX_TOKENS=8192
LLM_INTENT_MAX_TOKENS=8192
LLM_CONVERSATION_SUMMARY_MAX_TOKENS=512
LLM_MOTIVATION_SCORING_MAX_TOKENS=384
LLM_EMOTION_TRANSITION_MAX_TOKENS=384
LLM_EMPLOYEE_STATE_TRANSITION_MAX_TOKENS=4096
LLM_PSYCHOLOGICAL_PATTERN_DYNAMICS_MAX_TOKENS=1024
MOTIVATION_SCORING_LLM_TIMEOUT_SECONDS=20
EMOTION_TRANSITION_LLM_TIMEOUT_SECONDS=20
CONVERSATION_SUMMARY_LLM_TIMEOUT_SECONDS=20
GUIDANCE_LLM_TIMEOUT_SECONDS=120
COACH_EVALUATOR_LLM_TIMEOUT_SECONDS=120
COACH_REDLINE_LLM_TIMEOUT_SECONDS=120
CONVERSATION_RAW_TURN_WINDOW=12
CONVERSATION_SUMMARY_BATCH_TURNS=6
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
# 0 表示取消应用连接池配额（仍受 Redis/操作系统资源约束）。
REDIS_MAX_CONNECTIONS=0
DISTRIBUTED_COORDINATION_ENABLED=true
DISTRIBUTED_COORDINATION_KEY_PREFIX=hr_agent:coordination
DISTRIBUTED_LEASE_TTL_SECONDS=30
DISTRIBUTED_LEASE_POLL_INTERVAL_MS=50
DISTRIBUTED_SESSION_LOCK_TIMEOUT_SECONDS=900

# ==============================
# 登录、管理员与白名单
# 本地通过 HTTP 访问时 AUTH_COOKIE_SECURE=false；HTTPS 生产环境必须改为 true。
# AUTH_ALLOWED_EMAILS 仅在 AUTH_WHITELIST_ENABLED=true 时作为逐人白名单使用。
AUTH_ENABLED=true
# true 允许未登录用户以游客身份使用用户侧流程；管理员页面仍需管理员账号。
AUTH_GUEST_ACCESS_ENABLED=false
AUTH_COOKIE_NAME=hragent_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=30
AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=8
AUTH_WHITELIST_ENABLED=false
AUTH_ALLOWED_EMAILS=uay4sgh@bosch.com,fixed-term.yiheng.lu@cn.bosch.com
AUTH_ADMIN_EMAILS=uay4sgh@bosch.com,fixed-term.yiheng.lu@cn.bosch.com
# Registration and login accept any address in these domains; no per-user allowlist is required.
AUTH_ALLOWED_EMAIL_DOMAINS=cn.bosch.com,bosch.com
# 0 表示不限制全局活跃登录会话数。
AUTH_MAX_ACTIVE_SESSIONS=0
AUTH_LOGIN_RATE_LIMIT_PER_EMAIL=5/minute
AUTH_LOGIN_RATE_LIMIT_PER_IP=20/minute
AUTH_REGISTER_RATE_LIMIT_PER_IP=3/hour

# ==============================
# 语音输入
# local：受鉴权 WebSocket + 本地 Qwen3-ASR 原生流式识别。
# bosch：受鉴权 WebSocket + Bosch 分片预览，停止后用完整录音校正。
# browser：浏览器 SpeechRecognition，不创建后端录音或本地 ASR 容器。
# Bosch/API 模式的 ASR_API_KEY 留空时复用 API_KEY。
ASR_ENABLED=true
ASR_PROVIDER_MODE=local
ASR_API_KEY=
ASR_REALTIME_ENABLED=true
ASR_REALTIME_MODEL=Qwen/Qwen3-ASR-1.7B
# 不按页面语言限制本地语音输入，由 Qwen3-ASR 自动识别其支持的语言。
ASR_LOCAL_LANGUAGE_AUTO_DETECT=true
ASR_LOCAL_STREAMING_URL=http://qwen3_asr:7118
ASR_LOCAL_STREAMING_URLS=http://qwen3_asr:7118
ASR_LOCAL_CHUNK_MS=500
# 0 表示本地预览请求可一直等待公平批处理；停止录音会取消等待。
ASR_LOCAL_REQUEST_TIMEOUT_SECONDS=0
# 两个实例均满载时最多等待 2 秒；超时后继续录音并改用完整录音转写。
ASR_LOCAL_ADMISSION_TIMEOUT_SECONDS=2
# 新会话并行探测两个实例的 queue_depth；哈希仅用于同负载时打散。
ASR_LOCAL_ROUTING_PROBE_TIMEOUT_SECONDS=0.25
ASR_SAMPLE_RATE=16000
ASR_CONNECT_TIMEOUT_SECONDS=15
# 每实例最多保留 16 个有界会话；GPU 单批仍最多处理 10 路。
ASR_LOCAL_PREVIEW_MAX_CONCURRENCY=10
ASR_LOCAL_PREVIEW_MAX_SESSIONS=16
ASR_LOCAL_STREAM_WINDOW_SECONDS=12
ASR_LOCAL_STREAM_OVERLAP_SECONDS=1.5
# 每次本地流式状态重置时，将最近的已确认文本作为语义上下文传给下一窗口。
QWEN3_ASR_STREAM_CONTEXT_CHARS=160
ASR_LOCAL_SILENCE_COMMIT_MS=750
ASR_LOCAL_FORCE_REFRESH_MS=1000
ASR_LOCAL_SILENCE_RMS_THRESHOLD=0.006
# Bosch 文件接口先在 0.4 秒预览，之后每增加 0.75 秒累计校正。
ASR_BOSCH_PREVIEW_CHUNK_SECONDS=0.75
ASR_BOSCH_FIRST_PREVIEW_CHUNK_SECONDS=0.4
# 单次声学快照有界；完整预览文本仍持续累积到用户停止录音。
ASR_BOSCH_ACCUMULATION_MAX_SECONDS=20
ASR_BOSCH_PREVIEW_OVERLAP_MS=400
ASR_BOSCH_SILENCE_COMMIT_MS=400
ASR_BOSCH_VERIFIED_STREAM_FINAL_ENABLED=true
ASR_BOSCH_FINAL_HEDGE_DELAY_MS=150
ASR_BOSCH_TAIL_FINAL_TIMEOUT_SECONDS=8
ASR_BOSCH_MIN_SPEECH_MS=250
ASR_BOSCH_KEEPWARM_ENABLED=true
ASR_BOSCH_KEEPWARM_INTERVAL_SECONDS=45
ASR_BOSCH_PREVIEW_MAX_CONCURRENCY=8
ASR_BOSCH_PREVIEW_PER_SESSION_CONCURRENCY=2
# Cross-replica HTTP inference queue only; it never rejects recording sessions. Set 0 to disable it.
ASR_BOSCH_GLOBAL_MAX_CONCURRENCY=16
# Optional native Qwen realtime endpoint. Leave blank to retain cumulative HTTP preview.
ASR_BOSCH_REALTIME_URL=
ASR_BOSCH_REALTIME_MODEL=qwen3-asr-flash-realtime
ASR_BOSCH_REALTIME_VAD_THRESHOLD=0.2
ASR_BOSCH_REALTIME_SILENCE_MS=500
ASR_BOSCH_PROMPT=Bosch, 博世, TCL, SL1, SL2, G9, Performance Rating, Career Elements, Leadership Feedback, 高绩效文化
ASR_BOSCH_PROMPT_CONTEXT_CHARS=160
# 0 表示不拒绝新的录音 WebSocket。
ASR_CAPTURE_MAX_CONNECTIONS=0
ASR_LOCAL_FINAL_ENABLED=true
ASR_LOCAL_FINAL_SEGMENT_SECONDS=10
ASR_LOCAL_FINAL_PER_RECORDING_CONCURRENCY=2
ASR_LOCAL_FINAL_TIMEOUT_SECONDS=20
ASR_LOCAL_FINAL_MIN_PREVIEW_RATIO=0.45
# 远程后备路径使用短分段并行，避免单个超长请求。
ASR_FINAL_SEGMENT_SECONDS=45
# 相邻远程分段保留边界上下文，并在合并时仅去除可靠重复文本。
ASR_FINAL_SEGMENT_OVERLAP_SECONDS=1
ASR_FINAL_PER_RECORDING_CONCURRENCY=8
# 这是远程后备转写的计算上限，其他用户会排队。
ASR_FINAL_MAX_CONCURRENCY=8
ASR_RECORDING_TMP_DIR=/app/data/asr_tmp
ASR_RECORDING_MIN_FREE_BYTES=2147483648
ASR_RECORDING_ORPHAN_TTL_SECONDS=3600
ASR_HTTP_URL=https://aigc.bosch.com.cn/llmservice/api/v1/audio/transcriptions
ASR_HTTP_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=120
# 仅供旧版单文件上传接口兼容；0 表示不限制文件总大小。
# 实时录音会持续落盘并分段识别，单段长度不会限制录音总时长或文本总长度。
ASR_MAX_FILE_BYTES=0

# ==============================
# 员工回复语音输出总开关。false 时后端不调用 TTS，前端隐藏语音开关，
# 并且默认 docker compose 拓扑不会创建 Fish Audio 模型容器。
# 完整句子通过本地 vLLM-Omni Fish Audio S2-Pro 流式合成 44.1kHz 单声道 PCM。
# 当前模型 YAML 的 Stage 0 / Stage 1 均为 10；下方 TTS_STAGE_* 仅用于后端状态展示。
# 十路在独立 48 GiB GPU 上通过分句播放测试；十二路有重缓冲，不作为默认。
# 其他显存/共享部署需要重新压测，详见 docs/tts-throughput-tuning-20260906.md。
# 生产或商用部署前需确认已取得适用的 Fish Audio 模型许可。
TTS_ENABLED=true
TTS_PROVIDER=fish_vllm_omni
TTS_HTTP_URL=http://fish_tts:8091/v1/audio/speech
TTS_MODEL=/app/checkpoints/s2-pro
TTS_MODEL_REVISION=1de9996b6be38b745688de084d87a5633f714e4e
TTS_STAGE_0_MAX_NUM_SEQS=10
TTS_STAGE_1_MAX_NUM_SEQS=10
TTS_DEFAULT_VOICE=employee-natural
TTS_AVAILABLE_VOICES=employee-natural
TTS_RANDOM_VOICE_NAME=Fish Audio 默认音色
TTS_REQUIRE_REGISTERED_VOICE=true
# 首次部署先运行 scripts/bootstrap_fish_voice.py 注册纯合成参考音色；
# 如改用真人参考音频，请使用 scripts/register_fish_voice.py 并保留授权记录。
TTS_MAX_CONCURRENCY=10
# 单个 Fish 服务由所有 backend 共享；0 关闭跨副本的 Redis admission。
TTS_GLOBAL_MAX_CONCURRENCY=10
# 每句等待本地和全局名额的合计超时；0 表示持续等待，用户取消仍会释放排队任务。
TTS_QUEUE_TIMEOUT_SECONDS=0
# 每次 WebSocket 发送（含等待写锁）的上限；慢连接只取消语音，文字继续生成。
TTS_SEND_TIMEOUT_SECONDS=5
# 每个语音流待发送音频队列的双重上限；超限结束该语音流，避免内存持续累积。
TTS_AUDIO_QUEUE_MAX_BYTES=2097152
TTS_AUDIO_QUEUE_MAX_EVENTS=32
# 每路播放按各自缓冲节奏提交下一句；等待期间不占合成名额。
# 已缓冲>=8秒时暂停提交，<=4秒时恢复；3秒没有反馈则兼容旧客户端直接放行。
TTS_PLAYBACK_HIGH_WATER_SECONDS=8
TTS_PLAYBACK_LOW_WATER_SECONDS=4
TTS_PLAYBACK_FEEDBACK_TIMEOUT_SECONDS=3
TTS_CONNECT_TIMEOUT_SECONDS=2
TTS_GENERATION_TIMEOUT_SECONDS=120
TTS_SAMPLE_RATE=44100
TTS_SENTENCE_MAX_CHARS=180
# 只改变送入TTS的分段，不截短员工回复。首段只在自然边界提前发送。
TTS_FIRST_SEGMENT_MIN_CHARS=16
TTS_FIRST_SEGMENT_MAX_CHARS=64
TTS_FIRST_SEGMENT_WAIT_MS=350
# 后续仅合并已经到达的短句，不等待新的LLM文本凑字数。
TTS_SENTENCE_MERGE_MAX_CHARS=80
TTS_MAX_NEW_TOKENS=1024
# Fish S2-Pro 情绪 cue：inline=短主情绪+至多一个兼容语气；legacy=旧版复合标签回退；off=中性基线。
TTS_EMOTION_TAG_MODE=inline
TTS_EMOTION_MAX_TAGS=2
TTS_EMOTION_DELTA_THRESHOLD=0.10
# The legacy /v1/tts deployment still uses S2-Pro; use parentheses only for a true S1 server.
TTS_LEGACY_EMOTION_TAG_DELIMITER=square
# Docker Compose 使用固定 checkpoint revision，并在首次启动时下载到命名卷。
FISH_TTS_MODEL_REVISION=1de9996b6be38b745688de084d87a5633f714e4e

LLM_EMPLOYEE_MAX_TOKENS=8192
LLM_GUIDANCE_MAX_TOKENS=12288
LLM_COACH_EVALUATOR_MAX_TOKENS=12288
LLM_COACH_REDLINE_MAX_TOKENS=12288
LLM_TIMEOUT_SECONDS=120
EMPLOYEE_REPLY_LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_RESPONSE_FORMAT_STYLE=openai
LANGCHAIN_STRUCTURED_OUTPUT_STRATEGY=provider
LLM_WEB_SEARCH=false

# ==============================
# Redis 与 embedding 缓存
# 缓存 query embedding，降低重复检索延迟和 API 调用。
REDIS_URL=redis://redis:6379/0
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=604800
EMBEDDING_CACHE_KEY_PREFIX=hr_agent:query_embedding
RAG_RESULT_CACHE_ENABLED=true
RAG_RESULT_CACHE_TTL_SECONDS=900
RAG_RESULT_CACHE_MAX_ENTRIES=256
RAG_RESULT_CACHE_KEY_PREFIX=hr_agent:rag_result

# ==============================
# OpenTelemetry / SigNoz
# Compose 中后端先上报给 signoz_collection_agent；本机直接运行时可改为 http://localhost:4318。
# 容器 stdout 日志由采集 Agent 统一采集，因此禁用 SDK 日志导出，避免重复入库。
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=hr-agent-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.version=0.5.0-postgres-pgvector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_PYTHON_LOG_CORRELATION=true

# ==============================
# 应用行为
# ENABLE_TRACE 是原有应用调试开关，与 OpenTelemetry 导出配置相互独立。
ENABLE_TRACE=false
