{
  "schema_version": "1.1",
  "benchmark_id": "real-task-retrieval-v1",
  "description": "Six complete performance-conversation scenarios crossed with the eight production guidance and coach retrieval tasks. The 48 derived cases are deterministic and exercise job level, Career Elements, Bosch culture and ASR evidence together.",
  "case_count": 48,
  "top_k": 8,
  "coverage_contract": {
    "scenario_count": 6,
    "task_count": 8,
    "levels": [
      "G8",
      "G9",
      "SL1"
    ],
    "culture_terms": [
      "协同共进",
      "创变未来",
      "聚力共赢",
      "使命必达"
    ],
    "asr_combinations": [
      "what_met_how_strong",
      "what_mixed_how_met",
      "what_strong_how_gap",
      "what_strong_how_strong",
      "what_gap_how_gap",
      "what_persistent_gap_how_risk"
    ],
    "career_states": [
      "not_applicable",
      "unknown",
      "known_partial",
      "known_all_five"
    ]
  },
  "evaluation_boundaries": {
    "retrieval": "Top-3 gates verify only the evidence domains intentionally assigned to the generation prefix; Top-8 gates verify the complete applicable multi-domain contract and configured source quotas. A Career-scope hit is never itself a business violation.",
    "asr": "The six WHAT/HOW combinations are distinct production contexts, while retrieval is expected to return the shared WHAT/HOW framework. Whether guidance interprets each combination correctly is a manual end-to-end judgment.",
    "career": "Retrieving the formal five-element framework is useful evidence. Unknown-state confirmation, held-element exclusion and all-five no-new-element behavior are manual end-to-end judgments, not term-match failures."
  },
  "release_gates": {
    "automatic": {
      "mean_term_coverage_at_3": {
        "operator": ">=",
        "threshold": 0.9,
        "reason": "Across all 48 real-task cases, the first three results should cover nearly all task-specific prefix evidence concepts; complete multi-domain evidence remains a rank-eight contract."
      },
      "mean_term_coverage_at_8": {
        "operator": ">=",
        "threshold": 0.98,
        "reason": "The full production result window should leave almost no required evidence uncovered."
      },
      "full_term_coverage_at_8_rate": {
        "operator": ">=",
        "threshold": 0.95,
        "reason": "At least 46 of 48 cases should retrieve every required concept by rank eight."
      },
      "mean_scope_domain_coverage_at_3": {
        "operator": ">=",
        "threshold": 0.9,
        "reason": "The first three results should represent the required evidence domains, not only repeat one domain; final per-scope counts are checked at rank eight."
      },
      "full_scope_quota_coverage_at_8_rate": {
        "operator": ">=",
        "threshold": 0.98,
        "reason": "No more than one case may miss any configured per-scope result quota in the full result window."
      },
      "critical_evidence_failure_count": {
        "operator": "<=",
        "threshold": 0,
        "reason": "Every evidence profile declared critical for the task must have its required terms and source scope present by rank eight; semantic business use is reviewed separately."
      },
      "prompt_critical_evidence_failure_count": {
        "operator": "<=",
        "threshold": 0,
        "reason": "No critical evidence may disappear between retrieval and the actual generation payload."
      },
      "structured_bundle_failure_count": {
        "operator": "<=",
        "threshold": 0,
        "reason": "Each critical structured framework must remain complete in at least one prompt-visible passage."
      },
      "prompt_anchor_loss_count": {
        "operator": "<=",
        "threshold": 0,
        "reason": "Prompt budgeting must retain every retrievable child anchor that was present before budgeting."
      },
      "inapplicable_career_prompt_chars_total": {
        "operator": "<=",
        "threshold": 0,
        "reason": "Career Elements passages must not enter generation prompts when the scenario marks them inapplicable."
      }
    },
    "manual": {
      "top1_usable_rate": {
        "operator": ">=",
        "threshold": 0.9167,
        "reason": "At least 44 of 48 Top-1 passages must be directly usable in the production task."
      },
      "top1_direct_complete_rate": {
        "operator": ">=",
        "threshold": 0.75,
        "reason": "At least 36 of 48 Top-1 passages should directly and substantially support the task."
      },
      "top1_grade_zero_count": {
        "operator": "<=",
        "threshold": 0,
        "reason": "A completely irrelevant Top-1 result is a release blocker."
      },
      "normalized_dcg_at_3": {
        "operator": ">=",
        "threshold": 0.9,
        "reason": "Human grades for ranks one to three must remain concentrated on directly supporting passages."
      },
      "critical_business_violation_count": {
        "operator": "<=",
        "threshold": 0,
        "reason": "No result may invert Career applicability, recommend a held element as new, mis-map a culture term or invent an ASR rule."
      }
    },
    "comparison": {
      "mean_term_coverage_at_3_regression": {
        "operator": "<=",
        "threshold": 0.02,
        "reason": "A candidate retrieval policy may lose no more than two percentage points against the accepted baseline."
      },
      "critical_full_coverage_at_8_rate_regression": {
        "operator": "<=",
        "threshold": 0.05,
        "reason": "Critical-case full coverage may lose no more than five percentage points against baseline."
      },
      "top1_usable_rate_regression": {
        "operator": "<=",
        "threshold": 0.02,
        "reason": "Human Top-1 usability may lose no more than two percentage points against baseline."
      }
    }
  },
  "manual_grading": {
    "relevance_scale": {
      "0": "Irrelevant or misleading for the task.",
      "1": "Topically related but too generic or incomplete to use.",
      "2": "Useful and directly supportive, but another passage is needed for completeness.",
      "3": "Direct, applicable and substantially complete evidence for the task."
    },
    "judgment_format": {
      "cases": {
        "scenario_id::task_id": {
          "results": [
            {
              "rank": 1,
              "chunk_id": "current-top1-chunk-id",
              "source_id": "current-top1-source-id",
              "content_hash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
              "grade": 3
            },
            {
              "rank": 2,
              "chunk_id": "current-top2-chunk-id",
              "source_id": "current-top2-source-id",
              "content_hash": "123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0",
              "grade": 2
            },
            {
              "rank": 3,
              "chunk_id": "current-top3-chunk-id",
              "source_id": "current-top3-source-id",
              "content_hash": "23456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef01",
              "grade": 2
            }
          ],
          "critical_business_violation": false,
          "notes": "Copy rank, chunk_id, source_id and content_hash from the current benchmark report before grading. content_hash covers the complete prompt-visible passage body, not only its displayed excerpt. Review the excerpts together with career_state, held elements, culture term and ASR combination in manual_review_context."
        }
      }
    }
  },
