    {
      "scenario_id": "g9_development_career_unknown_commitment",
      "description": "G9 recruiter development conversation: regular hiring delivery is met, scarce-role delivery is mixed, and current Career Elements are unknown.",
      "level": "G9",
      "culture_term": "使命必达",
      "asr_combination": "what_mixed_how_met",
      "career_state": "unknown",
      "critical_profiles": [
        "job_level",
        "culture",
        "career",
        "asr"
      ],
      "context": {
        "intent": {
          "id": "development",
          "name": "发展型反馈"
        },
        "profile": {
          "name": "林敏",
          "role": "招聘专家",
          "level": "G9",
          "department": "HR Talent Acquisition",
          "reporting_line": "招聘负责人",
          "conversation_topic": "年度绩效与高端自动驾驶人才招聘策略发展",
          "performance_rating": "3",
          "tcl": "++",
          "key_goals": [
            "保障自动驾驶核心岗位招聘交付",
            "建立高端稀缺人才的可持续来源"
          ]
        },
        "motivation": {
          "primary_motive_id": "Recognition"
        },
        "emotion_state": {
          "current_anchor_id": "disappointed_but_engaged"
        },
        "career_elements_applicable": true,
        "current_career_elements": [],
        "career_elements_state": "unknown",
        "performance_context": "WHAT：常规岗位基本补齐，高端专家仍有缺口；HOW：拓宽猎头、内推和行业人脉，并与研发细化需求，但新的长期来源尚未系统形成。",
        "supplemental_info": "员工明确希望发展招聘策略和雇主品牌；当前已具备哪些Career Elements没有可靠记录，不能把未记录项直接判断为缺失；本次还需结合使命必达（Commitment to WIN）的行为标准。",
        "conversation": [
          {
            "turn_index": 0,
            "speaker": "manager",
            "content": "常规岗位交付不错，但高端专家还有缺口，我想听听你对原因的判断。"
          },
          {
            "turn_index": 1,
            "speaker": "employee",
            "content": "匹配量产经验的人才很少，我已经在做定向挖猎和需求校准，但长期来源还没系统搭起来。"
          },
          {
            "turn_index": 2,
            "speaker": "manager",
            "content": "你是G9，我希望下一步不只是扩大渠道，而是形成能够验证的招聘策略。"
          },
          {
            "turn_index": 3,
            "speaker": "employee",
            "content": "我认同需要形成策略，但高校合作和眼下稀缺岗位交付的作用周期需要分开看。"
          },
          {
